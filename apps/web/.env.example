# Required for real OpenAI token streaming. Without it, the app streams a demo response.
OPENAI_API_KEY=sk-your-key

# Optional. Defaults to gpt-5-mini for a fast/cost-conscious MVP.
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional for v0.2 persistent chat. If missing, the UI falls back to localStorage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional for Supabase Auth in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional cost controls for document indexing.
MAX_DOCUMENT_UPLOAD_BYTES=10485760
MAX_CHUNKS_PER_DOCUMENT=80

# Optional RAG quality controls.
RAG_CONTEXT_MAX_CHARS=5200
RAG_MIN_CONFIDENCE=0.12

# Optional reranking. Defaults to local heuristic; set JINA_API_KEY to use Jina rerank.
RERANK_PROVIDER=local
RERANK_CANDIDATE_LIMIT=40
JINA_API_KEY=your-jina-key
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
